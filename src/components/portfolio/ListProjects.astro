---
import Project from "./Project.astro";
import Heading from "../ui/Heading.astro";
import { Icon } from "astro-icon/components";

const allPosts = await Astro.glob("../../pages/portfolio/projects/*.md");

const getProjectUrl = (post: {
  url?: string;
  file?: string;
}) => {
  const fileName = post.file?.split(/[\\/]/).pop();
  const slug = fileName?.replace(/\.md$/i, "");

  // Build the public route directly from filename to avoid src/pages paths.
  if (slug) {
    return `/portfolio/projects/${encodeURIComponent(slug)}`;
  }

  if (post.url?.startsWith("/")) {
    return post.url;
  }

  return post.url ? `/${post.url}` : "/portfolio/projects";
};

allPosts.sort(
  (a, b) =>
    new Date(b.frontmatter.pubDate).getTime() -
    new Date(a.frontmatter.pubDate).getTime(),
);

const projectCategories = [
  {
    id: "web",
    title: "Proyectos Web",
    emptyMessage: "Todavía no hay proyectos web publicados.",
  },
  {
    id: "ai",
    title: "Proyectos IA - Computer Vision",
    emptyMessage: "Próximamente habrá nuevos proyectos de IA y Computer Vision.",
  },
];
---

<section
  class="bg-linear-to-t dark:from-[#0e0e10] from-white from-50% to-transparent to-100% scroll-m-16 relative pt-8 pb-32 max-2xl:px-8 max-md:pt-4"
  id="projects"
>
  <div class="mx-auto max-w-7xl py-8">
    <div class="flex gap-4 items-center justify-center text-center">
      <Icon class="text-3xl dark:text-white text-blacktext" name="code" />
      <Heading text="Proyectos" textGradient="Completados" textEn="Projects" textGradientEn="Completed" level={2} />
    </div>

    <p
      class="z-2 text-center mx-auto text-lg max-xl:text-base max-w-2xl dark:text-gray-200 text-blacktext my-6 leading-6 font-medium"
    >
  Me encanta <b
    class="bg-linear-to-r from-riptide-500 to-mint-500 dark:from-riptide-300 dark:to-mint-200 text-transparent bg-clip-text"
    >convertir ideas en proyectos reales.</b
  >
  <br /> Aquí te muestro algunos de los <b
    class="bg-linear-to-r from-riptide-500 to-mint-500 dark:from-riptide-300 dark:to-mint-200 text-transparent bg-clip-text"
    >desarrollos</b
  > en los que he trabajado, aplicando tecnología, diseño y mucha creatividad.
  <b
    class="bg-linear-to-r from-riptide-500 to-mint-500 dark:from-riptide-300 dark:to-mint-200 text-transparent bg-clip-text"
    >¡Descúbrelos!</b
  >
    </p>
    <slot />
  </div>

  <div
    id="containerProjects"
    class="mx-auto max-w-7xl"
  >
    {
      projectCategories.map((category) => {
        const projects = allPosts.filter(
          (post) => post.frontmatter.category === category.id,
        );

        return (
          <section class="mb-12 last:mb-0" aria-labelledby={`${category.id}-projects-title`}>
            <h3
              id={`${category.id}-projects-title`}
              class="mb-5 text-center text-2xl font-bold text-blacktext dark:text-mint-50"
            >
              {category.title}
            </h3>

            {projects.length > 0 ? (
              <div class="grid grid-cols-3 gap-5 p-2 max-lg:grid-cols-2 max-md:grid-cols-1">
                {projects.map((post) => (
                  <Project
                    url={getProjectUrl(post)}
                    title={post.frontmatter.title}
                    description={post.frontmatter.description}
                    date={post.frontmatter.pubDate}
                    languages={post.frontmatter.languages}
                    image={post.frontmatter.image}
                  />
                ))}
              </div>
            ) : (
              <p class="py-8 text-center text-lg font-medium text-blacktext/70 dark:text-gray-300">
                {category.emptyMessage}
              </p>
            )}
          </section>
        );
      })
    }
  </div>

</section>
